{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/auth/cleanup-unconfirmed",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/purge-deletions",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/health?daily=1",
      "schedule": "0 13 * * *"
    }
  ]
}
